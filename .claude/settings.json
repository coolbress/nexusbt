{
  "outputStyle": "Beginner or non-engineer",
  "skillListingBudgetFraction": 0.015,
  "extraKnownMarketplaces": {
    "plinth": {
      "source": {
        "source": "github",
        "repo": "coolbress/plinth"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(uv sync --locked)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv build)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git fetch origin)",
      "Bash(git worktree list:*)",
      "Bash(git worktree add --no-track -b:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh api user --jq .login)",
      "Bash(gh api 'repos/{owner}/{repo}' --jq .permissions.admin)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf:*)",
      "Bash(gh auth token*)",
      "Bash(gh auth status --show-token*)",
      "Bash(gh auth status -t*)",
      "Bash(gh repo delete:*)",
      "Bash(cat)",
      "Bash(tee:*)",
      "Bash(sed -i:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.test)",
      "Read(./.env.staging)",
      "Read(./.env.production)",
      "Bash(. *.env*)",
      "Bash(source *.env*)",
      "Bash(cat *.env)",
      "Bash(grep *.env)",
      "Read(~/.config/gh/**)"
    ]
  },
  "sandbox": {
    "filesystem": {
      "denyRead": [
        "./.env",
        "./.env.local",
        "./.env.*.local",
        "./.env.development",
        "./.env.test",
        "./.env.staging",
        "./.env.production"
      ]
    }
  }
}
